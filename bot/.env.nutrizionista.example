# Template per bot/.env.nutrizionista — copia in .env.nutrizionista e riempi i 3 segreti.
# Tutto il resto qui sotto NON è segreto: può restare com'è su qualunque macchina
# esegua questo bot.

# Segreto — chiave privata Nostr del Nutrizionista (genera con `npm run genkey` se
# stai creando una nuova identità; se stai migrando un bot esistente, riusa la
# stessa chiave per non perdere l'identità/pubkey già nota nel canale).
BUZZ_BOT_PRIVATE_KEY=

BUZZ_RELAY_URL=wss://fitness-2-0.communities.buzz.xyz
BUZZ_CHANNEL_ID=bf0357fa-ced9-4655-9eac-8abf2dfc25e5

AGENT_NAME=nutrizionista
AGENT_DISPLAY_NAME=Nutrizionista
PERSONA_PATH=../agents/nutrizionista.persona.md

# Pubkey del Personal Trainer (pubblica, non segreta) — per non rispondergli di iniziativa.
PEER_AGENT_PUBKEYS=ac2d05f4b56084a0f167e6cdecfbd9f6be8cd2e0c3b653cac7b33851a1ea060c

# Segreto — https://platform.openai.com/account/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

SUPABASE_URL=https://ijtzitnkduovcsjahlkm.supabase.co
# Segreto — Supabase dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=
