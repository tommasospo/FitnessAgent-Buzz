# Template per bot/.env.pt — copia in .env.pt e riempi i 3 segreti.
# Tutto il resto qui sotto NON è segreto (chiave Nostr pubblica, URL/ID pubblici del
# canale, nome agente): può restare com'è su qualunque macchina esegua questo bot.

# Segreto — chiave privata Nostr del Personal Trainer (genera con `npm run genkey`
# se stai creando una nuova identità; se stai migrando un bot esistente, riusa la
# stessa chiave per non perdere l'identità/pubkey già nota nel canale).
BUZZ_BOT_PRIVATE_KEY=

BUZZ_RELAY_URL=wss://fitness-2-0.communities.buzz.xyz
BUZZ_CHANNEL_ID=bf0357fa-ced9-4655-9eac-8abf2dfc25e5

AGENT_NAME=personal-trainer
AGENT_DISPLAY_NAME=Personal Trainer
PERSONA_PATH=../agents/personal-trainer.persona.md

# Pubkey del Nutrizionista (pubblica, non segreta) — per non rispondergli di iniziativa.
PEER_AGENT_PUBKEYS=480d56d8c4af10688cd8880468019fd537e055901b11568db307eef229e11fe7

# Segreto — https://platform.openai.com/account/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

SUPABASE_URL=https://ijtzitnkduovcsjahlkm.supabase.co
# Segreto — Supabase dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=
